{
  "name": "agent-cafe",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "npx -y @playwright/mcp@latest install-browser chrome-for-testing || true",
    "browser:install": "npx -y @playwright/mcp@latest install-browser chrome-for-testing",
    "login:local": "tsx --env-file=.env.local scripts/login-local.ts",
    "demo": "tsx --env-file=.env.local scripts/demo.ts",
    "electron:dev": "electron .",
    "electron:build": "next build && electron-builder",
    "electron:pack": "next build && electron-builder --dir"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.69",
    "@ai-sdk/gateway": "^3.0.98",
    "@ai-sdk/mcp": "^1.0.36",
    "@ai-sdk/openai-compatible": "^2.0.41",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/mcp": "^0.0.70",
    "ai": "^6.0.161",
    "next": "16.2.3",
    "playwright": "^1.60.0-alpha-1774999321000",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.agentcafe.desktop",
    "productName": "AgentCafe",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app/.next/standalone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "app/.next/standalone/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "app/.next/standalone/public",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/@playwright",
        "to": "app/node_modules/@playwright",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/playwright-core",
        "to": "app/node_modules/playwright-core",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/playwright",
        "to": "app/node_modules/playwright",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".env.local",
        "to": "app/.env.local"
      }
    ],
    "asar": true,
    "afterPack": "electron/after-pack.cjs",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "identity": null,
      "gatekeeperAssess": false
    },
    "dmg": {
      "writeUpdateInfo": false,
      "sign": false
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
